# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your tenant's IDs never reach GitHub.

# Entra admin center > Identity > Overview > Tenant ID
CA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Entra admin center > App registrations > CA Gap Analyzer (local) > Application (client) ID
CA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional: your break-glass (emergency access) accounts, comma-separated UPNs or object IDs.
# They're expected to be excluded from Conditional Access, so the identity checks won't flag
# them. If unset, the tool guesses and says so in the report.
# CA_BREAK_GLASS=breakglass01@contoso.onmicrosoft.com,breakglass02@contoso.onmicrosoft.com
