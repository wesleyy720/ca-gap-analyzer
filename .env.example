# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your tenant's IDs never reach GitHub.

# Entra admin center > Identity > Overview > Tenant ID
CA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Entra admin center > App registrations > CA Gap Analyzer (local) > Application (client) ID
CA_CLIENT_ID=00000000-0000-0000-0000-000000000000
